# Hover boots in a charger (redstone block on top, powered by a creative case): their charge
# (oc:charge, 15000 max) goes up from 0 by 100 every 10 ticks (chargerChargeRateTablet 10/tick). The player side of the boots (step height, jump boost,
# fall damage) is checked by client-player.sh.
forceload add 48 64 64 80
setblock 56 -60 70 opencomputers:casecreative
setblock 57 -60 70 opencomputers:charger
setblock 57 -59 70 minecraft:redstone_block
item replace block 57 -60 70 container.0 with opencomputers:hoverboots
WAIT 2
data get block 57 -60 70 "oc:items"
WAIT 10
data get block 57 -60 70 "oc:items"
